# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
FALLBACK_MODEL=llama-3.3-70b-versatile
SECONDARY_FALLBACK_MODEL=llama-3.1-8b-instant

# Telemetry & Logging
LOG_LEVEL=INFO

# Asymmetric Utility Matrix Constants
UTILITY_TP=10.0
UTILITY_FP=-50.0
UTILITY_FN=-2.0
UTILITY_TN=0.0

# OPM Sampling & Retrieval Hyperparameters
MC_SAMPLES=5
MC_TEMPERATURE=0.7
RETRIEVAL_THRESHOLD=0.35
